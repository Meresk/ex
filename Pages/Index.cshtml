@page
@model ex.Pages.IndexModel

<h1>Главная страница</h1>
<h2>Роль: @Model.UserRole</h2>

@if (Model.UserRole == "Guest")
{
    <p>👋 Вы вошли как гость</p>
}
else if (Model.UserRole == "Авторизированный клиент")  
{
    <p>✅ Вы обычный пользователь</p>
}
else if (Model.UserRole == "Менеджер")
{
    <p>📊 Вы менеджер</p>
}
else if (Model.UserRole == "Администратор")
{
    <p>⚡ Вы админ</p>
}

@if (Model.UserRole == "Менеджер" || Model.UserRole == "Администратор")
{
    <!-- Простая форма -->
    <form method="get">
        <input type="text" name="Search" value="@Model.Search" placeholder="Поиск..." 
            onchange="this.form.submit()">
        
        <select name="Sort" onchange="this.form.submit()">
            <option value="">По названию</option>
            <option value="price" selected="@(Model.Sort == "price")">По цене (дешевые)</option>
            <option value="price_desc" selected="@(Model.Sort == "price_desc")">По цене (дорогие)</option>
        </select>
    </form>
}

<!-- Список продуктов -->
@foreach (var product in Model.Products)
{
    <div class="card" >
        <div style="display: flex; padding: 20px;">
            <div class="card" style="width: 500px; margin-right: 20px; display: flex; align-items: center;">
                <img height="300" width="200" style=""/>
            </div>
            
            <div class="card" style="width: 100%; padding: 10px">
                <h3>@product.Category | @product.Title</h3>
                <p>Описание товара: @product.Description</p>
                <p>Производитель: @product.Manufacturer</p>
                <p>Поставщик: @product.Producer</p>
                <p>Цена: @product.Price руб.</p>
                <p>Единица измерения: @product.Unit</p>
                <p>Колличество на складе: @product.Amount</p>
            </div>

            <div class="card" style="width: 150px; margin-left: 20px">
                <p>Действующая скида</p>
            </div>
        </div>
    </div>
}

<a asp-page="/Login" asp-page-handler="Logout">Выйти</a>