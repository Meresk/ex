@page
@model ex.Pages.IndexModel

<h1>Главная страница</h1>
<h2>Роль: @Model.UserRole</h2>

@if (Model.UserRole == "Guest")
{
    <p>👋 Вы вошли как гость</p>
}
else if (Model.UserRole == "Авторизированный клиент")  
{
    <p>✅ Вы обычный пользователь</p>
}
else if (Model.UserRole == "Менеджер")
{
    <p>📊 Вы менеджер</p>
}
else if (Model.UserRole == "Администратор")
{
    <p>⚡ Вы админ</p>
}

@if (Model.UserRole == "Менеджер" || Model.UserRole == "Администратор")
{
    <!-- Простая форма -->
    <form method="get">
        <input type="text" name="Search" value="@Model.Search" placeholder="Поиск..." 
            onchange="this.form.submit()">
        
        <select name="Sort" onchange="this.form.submit()">
            <option value="">По названию</option>
            <option value="price" selected="@(Model.Sort == "price")">По цене (дешевые)</option>
            <option value="price_desc" selected="@(Model.Sort == "price_desc")">По цене (дорогие)</option>
        </select>
    </form>
}

<!-- Список продуктов -->
@foreach (var product in Model.Products)
{
    <!------------------------------ Главный контейнер карточка ------------------------------>
    <!-- margin: внешний отступ между карточками-->
    <div class="card" style="margin: 10px">

        <!------------------------------ Контейнер для правильного расположения элементов ------------------------------>
        <!-- diplay: flex: модуль который позволяет гибко управлять расположением элементов внутри себя-->
        <!-- padding: внутренний отступ чтобы элементы внутри "отлипли" от границ главной карточки-->
        <div style="display: flex; padding: 20px;">

            <!------------------------------ Контейнер с картинкой ------------------------------>
            <!-- align-items: center: расположение картинки внутри каточки по-центру -->
            <div class="card" style="width: 500px; display: flex; align-items: center;">
                <img height="300" width="200"/>
            </div>
            
            <!------------------------------ Контейнер с основной информацией ------------------------------>
            <!-- width: 100%: ширина контейнера с главной информацией занимае все оставшееся пространтво между картинкой и скидкой -->
            <!-- padding: внутренний отступ чтобы элементы внутри "отлипли" от границ карточки-->
            <!-- margin-left: внешний левый отступ от контейнера с картинкой -->
            <!-- margin-right: внешний правый отступ от контейнера со скидкой -->
            <div class="card" style="width: 100%; padding: 10px; margin-left: 20px; margin-right: 20px;">
                <h3>@product.Category | @product.Title</h3>
                <p>Описание товара: @product.Description</p>
                <p>Производитель: @product.Manufacturer</p>
                <p>Поставщик: @product.Producer</p>
                <p>Цена: @product.Price руб.</p>
                <p>Единица измерения: @product.Unit</p>
                <p>Колличество на складе: @product.Amount</p>
            </div>

            <!------------------------------ Контейнер со скидкой ------------------------------>
            <!-- align-items и justify-content: center: выравнивание контейнера с тектом внутри по центру-->
            <div class="card" style="display: flex; justify-content: center; align-items: center; padding: 10px">
                <!-- text-align: center: выравнивание текста внутри по центру (как в ворде) -->
                <div style="text-align: center">Действующая скидка: @product.Discount%</div>
            </div>
        </div>
    </div>
}

<a asp-page="/Login" asp-page-handler="Logout">Выйти</a>